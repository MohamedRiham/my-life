{
  "expo": {
    "name": "My Life",
    "slug": "my-life",
    "version": "1.0.0",
    "scheme": "my-life",
    "userInterfaceStyle": "automatic",
    "icon": "./src/assets/icons/app launch/launcher icon.png",
    "plugins": [
      "expo-status-bar",
      "expo-sqlite",
      "expo-secure-store",
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#2563EB",
          "defaultChannel": "task-reminders",
          "enableBackgroundRemoteNotifications": false,
          "icon": "./src/assets/icons/app launch/launcher icon.png",
          "sounds": [
            "./src/assets/sounds/notification_sound.wav"
          ]
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8FAFC",
          "image": "./src/assets/images/splash screen/light.png",
          "resizeMode": "contain",
          "imageWidth": 288,
          "enableFullScreenImage_legacy": true,
          "dark": {
            "backgroundColor": "#0B1120",
            "image": "./src/assets/images/splash screen/dark.png"
          }
        }
      ]
    ],
    "android": {
      "package": "com.mohomed_riham.mylife",
      "icon": "./src/assets/icons/app launch/launcher icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/icons/app launch/launcher icon foreground.png",
        "backgroundColor": "#F59E0B"
      }
    },
    "ios": {
      "icon": "./src/assets/icons/app launch/launcher icon.png"
    },
    "web": {
      "favicon": "./src/assets/icons/app launch/launcher icon.png"
    }
  }
}